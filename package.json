{
  "name": "glyph-drop-stats",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "wrangler types && tsc -b && vite build",
    "typecheck": "wrangler types && tsc -b",
    "lint": "oxlint --ignore-pattern 'vendor/**'",
    "check:synth-ui": "node scripts/check-synth-ui.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "npm run build && vite preview",
    "deploy": "CLOUDFLARE_ENV=production npm run build && wrangler deploy",
    "db:migrate:production": "wrangler d1 migrations apply glyph-drop-stats --env production --remote",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply glyph-drop-stats --local",
    "test:browser": "npm run build && node tests/browser/run.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@types/node": "^24.19.1",
    "oxlint": "^1.81.0",
    "playwright-core": "1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "workerd@1.20261001.1": true,
    "esbuild@0.28.1": true
  },
  "dependencies": {
    "@synth-ui/backend": "0.1.0",
    "@synth-ui/core": "0.1.0",
    "@synth-ui/widgets": "0.1.0"
  }
}
